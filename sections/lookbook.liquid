{{ 'lookbook.css' | asset_url | stylesheet_tag }}

{% assign lookbook = section.settings.lookbook %}

{% if lookbook %}
  {%- comment -%}
    S-02 draft guard: a Draft metaobject entry still passes the lookbook truthy check (the
    picker has a selection), but on the live storefront Shopify suppresses its field values —
    which would otherwise render an empty SectionBar/count shell.

    A metaobject exposes no draft/active status in Liquid (no published_at accessor — only
    .system + its defined fields), so draft detection relies on the live-storefront field
    suppression: a blank title.value means Shopify hid the values, i.e. the entry is draft.
    In design_mode all field values are accessible regardless of status, so this signal is
    unavailable there — we render the entry so it stays previewable in the customizer, and
    let the live storefront keep drafts hidden.
  {%- endcomment -%}
  {%- assign lookbook_is_draft = false -%}
  {%- unless request.design_mode -%}
    {%- if lookbook.title.value == blank -%}
      {%- assign lookbook_is_draft = true -%}
    {%- endif -%}
  {%- endunless -%}
  {%- unless lookbook_is_draft -%}
    {%- comment -%} Draft status can't be read in design_mode, so remind the merchant drafts stay hidden live. {%- endcomment -%}
    {%- if request.design_mode -%}
      <p class="page-width lookbook-design-note" role="note" style="margin: 0; padding: 8px 0; font-size: 11px; color: #6B6B6B;">
        Note: Draft lookbooks won’t appear on the live storefront.
      </p>
    {%- endif -%}
    <section
      class="page-width lookbook section-{{ section.id }}-lookbook"
      aria-label="Lookbook: {{ lookbook.title.value | escape }}"
    >
      {%- comment -%} SectionBar — rendered when Lookbook renders, hidden when label blank {%- endcomment -%}
      {%- if section.settings.label_section_bar != blank -%}
        <div class="lookbook__section-bar" aria-hidden="true">{{ section.settings.label_section_bar | escape }}</div>
      {%- endif -%}

      {%- comment -%} LookbookHero — only when hero_image field has a value (absent if no image) {%- endcomment -%}
      {%- assign hero_image = lookbook.hero_image.value -%}
      {%- if hero_image -%}
        {%- assign hero_alt = hero_image.alt | default: lookbook.title.value | default: '' -%}
        <div class="lookbook__hero">
          <img
            src="{{ hero_image | image_url: width: 1200 }}"
            alt="{{ hero_alt | escape }}"
            width="{{ hero_image.width }}"
            height="{{ hero_image.height }}"
            loading="lazy"
            fetchpriority="low"
          >
          <div class="lookbook__hero-text">
            {%- if section.settings.label_eyebrow != blank -%}
              <span class="lookbook__hero-eyebrow">{{ section.settings.label_eyebrow | escape }}</span>
            {%- endif -%}
            {%- assign heading_tag = section.settings.heading_level | default: 'h2' -%}
            <{{ heading_tag }} class="lookbook__hero-title">{{ lookbook.title.value | escape }}</{{ heading_tag }}>
            <span class="lookbook__hero-rule"></span>
            {%- if lookbook.description.value != blank -%}
              <div class="lookbook__hero-description">{{ lookbook.description | metafield_tag }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ProductCountBar + LookbookProductGrid + LookbookFooter — S-10: hidden when 0 products {%- endcomment -%}
      {%- assign products = lookbook.products.value -%}
      {%- assign product_count = products | size -%}
      {%- if product_count > 0 -%}
        <div class="lookbook__count-bar">
          {%- if section.settings.label_shop != blank -%}
            <span class="lookbook__count-label">{{ section.settings.label_shop | escape }}</span>
          {%- endif -%}
          <span class="lookbook__count-number" aria-hidden="true">
            {%- if product_count < 10 -%}0{%- endif -%}{{ product_count }}
          </span>
        </div>

        <ol class="lookbook__product-grid">
          {%- for product in products -%}
            {%- capture badge_num -%}{%- if forloop.index < 10 -%}0{%- endif -%}{{ forloop.index }}{%- endcapture -%}
            <li class="lookbook__card-item" data-index="{{ badge_num }}">
              <a
                class="lookbook__card-link"
                href="{{ product.url }}"
                aria-label="{{ product.title | escape }}"
              >
                <div class="lookbook__card-image-col">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="lookbook__card-body">
                  {%- if product.type != blank -%}
                    <span class="lookbook__card-category">{{ product.type | upcase }}</span>
                  {%- endif -%}
                  <h3 class="lookbook__card-title">{{ product.title | escape }}</h3>
                  <span class="lookbook__card-price">{{ product.price | money }}</span>
                  {%- if section.settings.label_cta != blank -%}
                    <span class="lookbook__card-cta">{{ section.settings.label_cta | escape }}</span>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ol>

        {%- comment -%} LookbookFooter — inside product guard: absent when 0 products (S-10) {%- endcomment -%}
        <div class="lookbook__footer">
          <span class="lookbook__footer-rule"></span>
          {%- if section.settings.label_footer != blank -%}
            <span class="lookbook__footer-label">{{ section.settings.label_footer | escape }}</span>
          {%- endif -%}
          <span class="lookbook__footer-rule"></span>
        </div>
      {%- endif -%}
    </section>
  {%- endunless -%}
{% endif %}

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "class": "section-lookbook",
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "t:sections.lookbook.settings.lookbook.label",
      "metaobject_type": "lookbook"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:sections.lookbook.settings.heading_level.label",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.lookbook.settings.labels_header.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.lookbook.settings.labels_header.info"
    },
    {
      "type": "text",
      "id": "label_section_bar",
      "label": "t:sections.lookbook.settings.label_section_bar.label",
      "default": "The Lookbook"
    },
    {
      "type": "text",
      "id": "label_eyebrow",
      "label": "t:sections.lookbook.settings.label_eyebrow.label",
      "default": "The Edit"
    },
    {
      "type": "text",
      "id": "label_shop",
      "label": "t:sections.lookbook.settings.label_shop.label",
      "default": "Shop the Edit"
    },
    {
      "type": "text",
      "id": "label_cta",
      "label": "t:sections.lookbook.settings.label_cta.label",
      "default": "View Product"
    },
    {
      "type": "text",
      "id": "label_footer",
      "label": "t:sections.lookbook.settings.label_footer.label",
      "default": "End of Edit"
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook.presets.lookbook.name"
    }
  ],
  "enabled_on": {
    "templates": ["index", "page", "collection", "product"]
  }
}
{% endschema %}
